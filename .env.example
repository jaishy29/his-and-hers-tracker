# Copy this file to ".env.local" and fill in the real values.
# .env.local is private and is NEVER uploaded to GitHub.
# With no Supabase values, the app runs in "practice mode" with pretend data.

# --- Supabase (Project Settings -> API Keys) ---
# The project URL and the PUBLISHABLE key (starts with sb_publishable_; older projects call it the "anon" key).
# Both are safe to show in the browser: the database security rules protect your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# SECRET key (starts with sb_secret_; older projects call it "service_role"). Needed from Milestone 6.
# Never share this one or put it in chat. It can read and change everything.
SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Web Push (generated later with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- Shared secret the scheduled reminder job sends so only it can trigger reminders ---
CRON_SECRET=make-up-a-long-random-string
