# Copy this file to ".env.local" and fill in the real values.
# .env.local is private and is NEVER uploaded to GitHub.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Web Push (generated later with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- Shared secret the scheduled reminder job sends so only it can trigger reminders ---
CRON_SECRET=make-up-a-long-random-string
